      "conditioning": [
        "30:6",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Conditioning Zero Out"
    }
  },
  "30:19": {
    "inputs": {
      "value": ""
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "Text String (User Prompt)"
    }
  }
}
"""

def queue_prompt(prompt):
    p = {"prompt": prompt}

    data = json.dumps(p).encode('utf-8')
    req = request.Request(f"{SERVER_URL}/prompt", data=data, headers={"Content-Type": "application/json"})
    with request.urlopen(req, timeout=30) as response:
        result = json.load(response)
    # print(json.dumps(result))
    if "prompt_id" not in result:
        raise RuntimeError(f"ComfyUI did not accept the prompt: {result}")
    return result["prompt_id"]


def wait_for_prompt(prompt_id):
    deadline = time.monotonic() + WAIT_TIMEOUT
    while True:
        with request.urlopen(f"{SERVER_URL}/history/{prompt_id}", timeout=30) as response:
            history = json.load(response)
        if prompt_id in history:
            return history[prompt_id]
        if time.monotonic() >= deadline:
            raise TimeoutError(f"Timed out waiting for prompt {prompt_id}")
        time.sleep(POLL_INTERVAL)


def unload_models():
    data = json.dumps({"unload_models": True, "free_memory": True}).encode("utf-8")
    req = request.Request(f"{SERVER_URL}/free", data=data, headers={"Content-Type": "application/json"})
    with request.urlopen(req, timeout=30):
        pass


def non_empty_prompt(value):
    if not value.strip():
        raise argparse.ArgumentTypeError("prompt must not be empty")
    return value


def check_server():
    try:
        with request.urlopen(f"{SERVER_URL}/system_stats", timeout=3) as response:
            if "system" not in json.load(response):
                raise ValueError("unexpected response from /system_stats")
    except (OSError, ValueError) as exc:
        print(f"Warning: ComfyUI server is not available at {SERVER_URL}: {exc}", file=sys.stderr)
        raise SystemExit(1) from None


parser = argparse.ArgumentParser(description="Generate an image with the local ComfyUI server.")
parser.add_argument(
    "prompt",
    type=non_empty_prompt,
    help="Text prompt for the generated image",
)
parser.add_argument(
    "-o", "--output-path",
    default="/tmp/",
    help="Directory where ComfyUI saves the image (default: /tmp)",
)
parser.add_argument(
    "-a", "--aspect-ratio",
    choices=ASPECT_RATIOS,
    default="1:1",
    help="Image aspect ratio (default: %(default)s)",
)
args = parser.parse_args()

check_server()

prompt = json.loads(prompt_text)
prompt["30:19"]["inputs"]["value"] = args.prompt
prompt["30:3"]["inputs"]["seed"] = random.randint(0, 2**64 - 1)
prompt["52"]["inputs"]["output_path"] = args.output_path
prompt["49"]["inputs"]["aspect_ratio"] = ASPECT_RATIOS[args.aspect_ratio]


print("Submitting prompt to ComfyUI...", file=sys.stderr)
prompt_id = queue_prompt(prompt)
print(f"Prompt queued ({prompt_id}). Waiting for image generation...", file=sys.stderr)
history = wait_for_prompt(prompt_id)
try:
    status = history.get("status", {})
    if status.get("status_str") != "success":
        raise RuntimeError(f"Prompt {prompt_id} failed: {status}")

    output = history.get("outputs", {}).get("52", {})
    files = output.get("files") or [image["filename"] for image in output.get("images", [])]
    if not files:
        raise RuntimeError(f"Prompt {prompt_id} completed without an image from node 52")
    for filename in files:
        print(filename)
finally:
    try:
        unload_models()
    except OSError as exc:
        print(f"Warning: could not request model unload: {exc}", file=sys.stderr)
