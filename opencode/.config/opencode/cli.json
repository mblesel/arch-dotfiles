{
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": {
        "name": "system",
        "mode": "system"
    },
    "animations": false,
    "session": {
        "sidebar": "auto",
        "thinking": "hide",
        "markdown": "rendered",
        "grouping": "auto",
        "image_preview": true,
        "tps": true,
        "permissions": "prompt"
    },
    "prompt": {
        "image_preview": true
    },
    "keybinds": {
        "leader": "ctrl+space",
        "app.exit": [
            "ctrl+c",
            "<leader>q"
        ],
        "prompt.paste": {
            "key": "ctrl+v",
            "event": "press",
            "preventDefault": false,
            "fallthrough": false
        },
        "help.show": false,
        "input.newline": "shift+return,ctrl+return",
        "dialog.select.prev": "up,ctrl+k",
        "dialog.select.next": "down,ctrl+j"
    },
    "leader": {
        "timeout": 2000
    }
}
