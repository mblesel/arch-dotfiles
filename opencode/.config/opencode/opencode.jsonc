{
    "$schema": "https://opencode.ai/config.json",
    "shell": "/bin/bash",
    // default model
    "model": "openai/gpt-6.1-sol#high", 
    "default_agent": "Huginn",
    "media": {
        "image": {
            "auto_resize": true,
            "max_width": 2000,
            "max_height": 2000,
            "max_base64_bytes": 5242880,
        },
    },
    "attention": {
        "notifications": true,
        "sound": true,
        "volume": 0.4,
        "sound_pack": "opencode.default",
        // "sounds": {
            // "permission": "/home/me/sounds/permission.wav"
        // }
    },
    // "skills": ["./team-skills", "https://example.com/.well-known/skills/"], TODO
    "websearch": {
        "provider": "tavily",
    },
    "permissions": [
        {
            "action": "websearch",
            "resource": "*",
            "effect": "ask",
        },
    ],
    "experimental": {
        "policies": [
            { "action": "permission", "resource": "shell:git push *", "effect": "deny" },
            { "action": "permission", "resource": "read:*/.ssh/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*/.secrets", "effect": "deny" },
        ],
    },
    "provider": {
        "ollama": {
            "settings": {
                "baseURL": "http://localhost:11434/v1",
                "apiKey": "NONE",
            },
        }
    },
}
