{
    "$schema": "https://opencode.ai/config.json",
    "shell": "/bin/bash",
    // default model
    "model": "openai/gpt-6-sol#medium", 
    // "default_agent": "TODO",
    // "formatter": true, TODO check if I want this
    "media": {
        "image": {
            "auto_resize": true,
            "max_width": 2000,
            "max_height": 2000,
            "max_base64_bytes": 5242880,
        },
    },
    // "skills": ["./team-skills", "https://example.com/.well-known/skills/"], TODO
    "websearch": {
        "provider": "tavily",
    },
    "permissions": [
        {
            "action": "websearch",
            "resource": "*",
            "effect": "ask",
        },
    ],
    "experimental": {
        "policies": [
            { "action": "permission", "resource": "shell:git push *", "effect": "deny" },
            { "action": "permission", "resource": "read:*/.ssh/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*/.secrets", "effect": "deny" },
        ],
    },
    "provider": {
        "ollama": {
            "settings": {
                "baseURL": "http://localhost:11434/v1",
                "apiKey": "NONE",
            },
        }
    },
}
