{
    "network": {
        "allowedDomains": [
            "opencode.ai",
            "*.opencode.ai",
            "github.com",
            "*.github.com",
            "*.githubusercontent.com",
            "*.x.ai",
            "*.anthropic.com",
            "*.openai.com",
            "127.0.0.1",
            "localhost"
        ],
        "deniedDomains": [],
        "allowAllUnixSockets": true,
        "allowLocalBinding": true
    },
    "filesystem": {
        "denyRead": [
            "~"
        ],
        "allowRead": [
            "~/.config/opencode",
            "~/Projects/arch-dotfiles/opencode",
            "~/.local/share/opencode",
            "~/.cache/opencode",
            "~/.local/state/opencode",
            "/tmp",
            "."
        ],
        "allowWrite": [
            "~/.config/opencode",
            "~/Projects/arch-dotfiles/opencode",
            "~/.local/share/opencode",
            "~/.cache/opencode",
            "~/.local/state/opencode",
            "/tmp",
            "."
        ],
        "denyWrite": []
    },
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "allowAppleEvents": false
}
